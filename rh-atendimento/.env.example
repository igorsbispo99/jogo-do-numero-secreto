# =====================================================================
# Copie este arquivo para .env.local e preencha com os seus valores.
# Na Vercel, cadastre as mesmas chaves em Settings > Environment Variables.
# =====================================================================

# --- Supabase (Project Settings > API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica
# Segredo: nunca use no navegador, nunca comite.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# --- Endereço público do sistema (usado nos links dos e-mails) --------
NEXT_PUBLIC_URL_BASE=https://rh.suaempresa.com.br

# --- E-mail (opcional: sem isso o sistema funciona, só não envia) -----
# Crie a conta gratuita em https://resend.com (3.000 e-mails/mês).
RESEND_API_KEY=
# Enquanto o domínio não estiver validado, use: RH Grupo TEA <onboarding@resend.dev>
EMAIL_REMETENTE=RH Grupo TEA <onboarding@resend.dev>
# Quem recebe o aviso de chamado novo (separe por vírgula).
EMAIL_AVISO_RH=rh@suaempresa.com.br

# --- Rotina de limpeza dos anexos (retenção de 30 dias) ---------------
# Qualquer texto longo e aleatório. Protege /api/limpeza-anexos.
CRON_SECRET=
